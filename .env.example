# Kopiera den här filen till .env och fyll i värdena. .env är git-ignorerad
# och ska aldrig committas.
#
# OBS - säkerhetsmodellen för det här repot: kundsajten är HELT publik och
# skrivskyddad. Här får det ALDRIG ligga Cognito-ID:n, tokens, AWS-nycklar
# eller andra hemligheter. Allt som börjar med VITE_ bakas in i den publika
# JS-bundeln och är synligt för varje besökare.

# Bas-URL till backend-API:t (API Gateway). Kundsajten anropar bara de
# publika GET-rutterna (menyn) - ingen inloggning, inga tokens.
# VITE_API_BASE_URL=https://dh2m5ildm7.execute-api.eu-north-1.amazonaws.com

# Restaurangens plats-ID i API:t (samma id som admin-panelen använder).
# Hittas i admin-panelen: Inställningar, eller localStorage-nyckeln
# "admin-location-id" i en inloggad admin-webbläsare.
# VITE_LOCATION_ID=

# Bas-URL (CloudFront/CDN) för menybilder. API:t returnerar bara S3-nyckeln
# (imageKey, med prefixet menu-images/); utan den här variabeln visas en
# platshållare i stället för bilder.
# VITE_MENU_IMAGE_BASE_URL=https://d34fv5yun0ld7v.cloudfront.net
