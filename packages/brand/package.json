{
  "name": "@booqy/brand",
  "version": "0.1.0",
  "description": "Booqy's shared brand system: tokens (CSS variables, TS, email JSON and Python), effects (glass, liquid fill, count-up, skeletons, receipt print, busy, theme sweep, glide, press ripple and click sound), the Bar family and the shared components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.js",
    "./src/styles.ts"
  ],
  "files": [
    "dist",
    "tokens.json",
    "scripts/brand-lint.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "brand-lint": "scripts/brand-lint.mjs"
  },
  "exports": {
    ".": {
      "@booqy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@booqy/source": "./src/styles/index.css",
      "default": "./dist/brand.css"
    },
    "./tokens.json": "./tokens.json",
    "./email-tokens.json": "./dist/email-tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs --check && tsc -p tsconfig.json && vite build && vite build --config vite.static.config.ts && tsc -p tsconfig.build.json && node scripts/copy-email-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "brand-lint": "node scripts/brand-lint.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
