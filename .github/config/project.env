AWS_REGION=eu-north-1

# --- dev ---------------------------------------------------------------
OIDC_ROLE_ARN_DEV=arn:aws:iam::877653167825:role/dev-customer-front-end-deploy-role
S3_BUCKET_DEV=dev-customer-front-end-asset-877653167825
CLOUDFRONT_DISTRIBUTION_ID_DEV=EVIBPZN3DMJKB
# Publika byggvärden (inte hemligheter - de hamnar i den publika JS-bundeln).
# Kundsajten anropar bara API:ts publika GET-rutter - inga tokens, ingen
# Cognito-konfiguration ska någonsin in i det här repot.
VITE_API_BASE_URL_DEV=https://dh2m5ildm7.execute-api.eu-north-1.amazonaws.com
# Sajten tar reda på sin restaurang själv vid start (GET /site-config?host=).
# På *.cloudfront.net går det inte, så i dev väljs restaurangen med
# ?restaurang=<slug> i URL:en eller den här standard-sluggen (slug i
# Booqy Console). API:t godtar slug bara utanför prod.
VITE_DEV_TENANT_SLUG_DEV=test-restaurang-2
# Kundsajtens CloudFront-domän. Kräver att distributionen har behaviorn
# /menu-images/* → bild-bucketen (samma mönster som admin-distributionen);
# utan den visas platshållare. Bara domänen: imageKey bär redan prefixet
# menu-images/.
VITE_MENU_IMAGE_BASE_URL_DEV=https://d3kaislpxcbglq.cloudfront.net

# --- prod ----------------------------------------------------------------
OIDC_ROLE_ARN_PROD=arn:aws:iam::343695380960:role/customer-front-end-deploy-role
S3_BUCKET_PROD=customer-front-end-asset-343695380960
CLOUDFRONT_DISTRIBUTION_ID_PROD=E4BZA4TL2WN5C
# REPLACE_ME tills prod-API:t är deployat - bygget shippar ändå, med sajten
# visad som otillgänglig tills värdena finns.
VITE_API_BASE_URL_PROD=REPLACE_ME
# Tom i prod: där avgör restaurangens egen domän vilken restaurang det är.
VITE_DEV_TENANT_SLUG_PROD=
VITE_MENU_IMAGE_BASE_URL_PROD=REPLACE_ME
